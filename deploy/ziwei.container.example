# Podman quadlet 示例：放到 ~/.config/containers/systemd/ziwei.container
# 然後 systemctl --user daemon-reload && systemctl --user start ziwei
[Unit]
Description=ziwei-doushu 紫微排盤

[Container]
ContainerName=ziwei
Image=localhost/ziwei-doushu:latest
# 只想在區網用就綁定區網 IP，例如 PublishPort=192.168.1.10:3000:3000
PublishPort=127.0.0.1:3000:3000
# 資料目錄唯讀掛進容器（底下 v4/、twins/、corpus/，對應 .env.example 的預設路徑）
Volume=%h/ziwei/data:/data:ro,Z
# AI 金鑰等環境變數（權限設 600，不要放進 repo）
EnvironmentFile=%h/ziwei/deploy/ai.env

[Service]
Restart=always

[Install]
WantedBy=default.target
