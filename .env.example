# 复制为 .env.local 后填入实际值。只看排盘可以全部不填。

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 页尾「赞助本站」连结；不设定则用本 fork 维护者的赞助页，设成空字串则不显示
# NEXT_PUBLIC_DONATE_URL=

# ─── AI 问盘、四化飞化、合盘（OpenAI 兼容端点；三个缺一就回 503「AI 尚未设定」）───
# Azure OpenAI 示例：AI_BASE_URL=https://<资源名>.openai.azure.com/openai/v1，AI_MODEL 填部署名称
# 请求同时带 api-key 与 Authorization: Bearer 标头，一般 OpenAI 兼容服务也能用
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini
# 全站每分钟 AI 请求上限
# AI_RATE_LIMIT_PER_MINUTE=20

# ─── 资料（服务端读取；没有对应资料的功能会显示读取失败，其余照常）───
# 13 维解读：v4 jsonl 与位元组偏移索引（scripts/reading/build-index.ts 产生）
# READING_DATA_DIR=/data/v4/jsonl
# READING_INDEX_DIR=/data/v4/index
# 命理学双子索引（scripts/twins/build-index.ts 产生）
# TWINS_INDEX_FILE=/data/twins/twins-index.json
# 三纪字幕导播语料：底下放 tianji/entries.jsonl、renji/entries.jsonl
# SANJI_DATA_DIR=/data/corpus

# ─── 搜寻引擎站点验证（选填）───
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
