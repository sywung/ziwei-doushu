# 複製為 .env.local 後填入實際值。只看排盤可以全部不填。

# ─── 站點 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 頁尾「贊助本站」連結；不設定則用本 fork 維護者的贊助頁，設成空字串則不顯示
# NEXT_PUBLIC_DONATE_URL=

# ─── AI 問盤、四化飛化、合盤（OpenAI 兼容端點；三個缺一就回 503「AI 尚未設定」）───
# Azure OpenAI 示例：AI_BASE_URL=https://<资源名>.openai.azure.com/openai/v1，AI_MODEL 填部署名稱
# 請求同時帶 api-key 與 Authorization: Bearer 標頭，一般 OpenAI 兼容服務也能用
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini
# 全站每分鐘 AI 請求上限
# AI_RATE_LIMIT_PER_MINUTE=20

# ─── 資料（服務端讀取；沒有對應資料的功能會顯示讀取失敗，其餘照常）───
# 13 維解讀：v4 jsonl 與位元組偏移索引（scripts/reading/build-index.ts 產生）
# READING_DATA_DIR=/data/v4/jsonl
# READING_INDEX_DIR=/data/v4/index
# 命理學雙子索引（scripts/twins/build-index.ts 產生）
# TWINS_INDEX_FILE=/data/twins/twins-index.json
# 三紀字幕導播語料：底下放 tianji/entries.jsonl、renji/entries.jsonl
# SANJI_DATA_DIR=/data/corpus

# ─── 搜尋引擎站點驗證（選填）───
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
